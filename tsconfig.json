{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "rootDir": "./src",
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    // 
    "skipLibCheck": true,

  },
  "include": ["src"]
}
